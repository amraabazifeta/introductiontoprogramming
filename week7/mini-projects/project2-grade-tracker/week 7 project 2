import csv

def main():
    filename = "grades.csv"
    
    # Initialize lists and variables to store data
    scores = []
    students = []  # List of dictionaries to store name-score pairs
    
    # Dictionary for Grade Distribution
    distribution = {"A": 0, "B": 0, "C": 0, "D": 0, "F": 0}

    try:
        with open(filename, "r") as file:
            reader = csv.DictReader(file)
            for row in reader:
                name = row["name"]
                # Convert string score from CSV to integer
                score = int(row["score"])
                
                scores.append(score)
                students.append({"name": name, "score": score})
                
                # Determine grade band
                if score >= 90:
                    distribution["A"] += 1
                elif score >= 80:
                    distribution["B"] += 1
                elif score >= 70:
                    distribution["C"] += 1
                elif score >= 60:
                    distribution["D"] += 1
                else:
                    distribution["F"] += 1

    except FileNotFoundError:
        print(f"Error: The file '{filename}' was not found.")
        return
    except ValueError:
        print("Error: The CSV contains non-numeric score data.")
        return

    # Statistical Calculations
    total_students = len(scores)
    
    # Safety check for empty files
    if total_students == 0:
        print("No student data found in the file.")
        return

    average = sum(scores) / total_students
    
    # Find max and min using lambda functions for clarity
    highest = max(students, key=lambda x: x["score"])
    lowest = min(students, key=lambda x: x["score"])

    # --- Output Report ---
    print("=== Quiz Grade Summary ===")
    print(f"Students assessed : {total_students}")
    print(f"Average score     : {average:.1f}")
    print(f"Highest score     : {highest['score']}  ({highest['name']})")
    print(f"Lowest score      : {lowest['score']}  ({lowest['name']})")
    
    print("\nGrade Distribution:")
    print(f"  A (90-100) : {distribution['A']} students")
    print(f"  B (80-89)  : {distribution['B']} students")
    print(f"  C (70-79)  : {distribution['C']} students")
    print(f"  D (60-69)  : {distribution['D']} students")
    print(f"  F ( 0-59)  : {distribution['F']} students")

if __name__ == "__main__":
    main()
