import csv

# ── Step 1: Read the CSV and count languages ──────────────────────────────────
counts = {}

# Dosyayı okuma modunda açıyoruz
with open("../../week1/favorites.csv", "r") as file:
    reader = csv.DictReader(file)
    for row in reader:
        # CSV başlığındaki 'language' sütununu alıyoruz
        language = row["language"]

        # Eğer dil sözlükte varsa artır, yoksa 1'den başlat
        if language in counts:
            counts[language] += 1
        else:
            counts[language] = 1

# ── Step 2: Sort by popularity (most popular first) ───────────────────────────
# counts.get fonksiyonunu anahtar olarak kullanarak değerlere göre sıralıyoruz
sorted_languages = sorted(counts, key=counts.get, reverse=True)

# ── Step 3: Print the report ──────────────────────────────────────────────────
print("=== Language Popularity Report ===")

# Enumerate kullanarak 1'den başlayan bir sıralama (rank) oluşturuyoruz
for rank, language in enumerate(sorted_languages, start=1):
    # :<10 ifadesi metni 10 karakterlik alanda sola yaslar (hizalama için)
    print(f"{rank}. {language:<10} : {counts[language]} students")

# Toplam cevap sayısını sum() ile hesaplıyoruz
total = sum(counts.values())
print(f"\nTotal responses: {total}")
