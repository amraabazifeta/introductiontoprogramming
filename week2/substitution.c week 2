// This program encrypts messages using a substitution cipher.
// It replaces each letter of the alphabet with a corresponding letter
// from a 26-character key provided as a command-line argument.

#include <cs50.h>
#include <ctype.h>
#include <stdio.h>
#include <string.h>

bool is_valid_key(string key);

int main(int argc, string argv[])
{
    // Step 1: Validate command-line arguments
    if (argc != 2)
    {
        printf("Usage: ./substitution key\n");
        return 1;
    }

    if (!is_valid_key(argv[1]))
    {
        printf("Key must contain 26 unique characters.\n");
        return 1;
    }

    string key = argv[1];

    // Step 2: Get plaintext from user
    string plaintext = get_string("plaintext:  ");

    // Step 3: Encrypt and print ciphertext
    printf("ciphertext: ");

    for (int i = 0, n = strlen(plaintext); i < n; i++)
    {
        if (isalpha(plaintext[i]))
        {
            // Determine the position in the alphabet (0-25)
            int index = isupper(plaintext[i]) ? plaintext[i] - 'A' : plaintext[i] - 'a';

            // Get the substituted letter from the key
            char substituted = key[index];

            // Print with preserved case
            if (isupper(plaintext[i]))
            {
                printf("%c", toupper(substituted));
            }
            else
            {
                printf("%c", tolower(substituted));
            }
        }
        else
        {
            // Print non-letters as they are
            printf("%c", plaintext[i]);
        }
    }

    printf("\n");
    return 0;
}

bool is_valid_key(string key)
{
    // Check length
    if (strlen(key) != 26)
    {
        return false;
    }

    bool seen[26] = {false};

    for (int i = 0; i < 26; i++)
    {
        // Check if character is a letter
        if (!isalpha(key[i]))
        {
            return false;
        }

        // Check for duplicates (case-insensitive)
        int index = tolower(key[i]) - 'a';
        if (seen[index])
        {
            return false;
        }
        seen[index] = true;
    }

    return true;
}
