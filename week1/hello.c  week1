// This simple program asks the user for their name 
// and prints a personalized greeting.

#include <cs50.h>
#include <stdio.h>

int main(void)
{
    // Prompt the user for their name
    // We use the CS50 library function get_string
    string name = get_string("What is your name? ");

    // Print the greeting using the variable 'name'
    // %s is the placeholder for a string
    printf("hello, %s\n", name);
}
