// Helper: Toggle Loading State
const toggleLoader = (show) => {
    document.getElementById('loader').classList.toggle('hidden', !show);
};

// --- Task 1: Your First Fetch (Quotes) ---
async function fetchQuote() {
    const display = document.getElementById('quote-display');
    display.innerHTML = "<em>Loading quote...</em>";
    
    try {
        const response = await fetch('https://api.quotable.io/random');
        if (!response.ok) throw new Error("Could not fetch quote.");
        
        const data = await response.json();
        display.innerHTML = `<blockquote>"${data.content}"</blockquote><p>— ${data.author}</p>`;
    } catch (error) {
        display.innerHTML = `<p class="error">Error: ${error.message}</p>`;
    }
}

// --- Task 2: GitHub User Search ---
async function searchUser() {
    const username = document.getElementById('github-input').value;
    const resultDiv = document.getElementById('github-result');
    
    if (!username) return;
    toggleLoader(true);
    resultDiv.innerHTML = "";

    try {
        const response = await fetch(`https://api.github.com/users/${username}`);
        
        if (response.status === 404) {
            throw new Error("User not found");
        } else if (!response.ok) {
            throw new Error("GitHub API Error");
        }

        const user = await response.json();
        resultDiv.innerHTML = `
            <div class="github-card">
                <img src="${user.avatar_url}" alt="${user.login}" width="100">
                <h3>${user.name || user.login}</h3>
                <p>${user.bio || 'No bio available'}</p>
                <ul>
                    <li>Followers: ${user.followers}</li>
                    <li>Public Repos: ${user.public_repos}</li>
                </ul>
                <a href="${user.html_url}" target="_blank">View Profile</a>
            </div>
        `;
    } catch (error) {
        resultDiv.innerHTML = `<p class="error">${error.message}</p>`;
    } finally {
        toggleLoader(false);
    }
}

// --- Task 3: Browse Posts (JSONPlaceholder) ---
let postStart = 0;
async function loadPosts() {
    const container = document.getElementById('posts-container');
    toggleLoader(true);

    try {
        const response = await fetch(`https://jsonplaceholder.typicode.com/posts?_start=${postStart}&_limit=10`);
        const posts = await response.json();

        posts.forEach(post => {
            const card = document.createElement('div');
            card.className = 'post-card';
            card.innerHTML = `<h3>${post.title}</h3><p>${post.body}</p>`;
            card.addEventListener('click', () => loadComments(post.id, card));
            container.appendChild(card);
        });

        postStart += 10;
    } catch (error) {
        console.error("Failed to load posts", error);
    } finally {
        toggleLoader(false);
    }
}

async function loadComments(postId, element) {
    try {
        const response = await fetch(`https://jsonplaceholder.typicode.com/posts/${postId}/comments`);
        const comments = await response.json();
        
        const commentList = document.createElement('div');
        commentList.className = 'comments-section';
        commentList.innerHTML = "<h4>Comments:</h4>" + comments.map(c => `<p><strong>${c.email}:</strong> ${c.body}</p>`).join('');
        
        // Remove old comments if they exist before adding new ones
        const existing = element.querySelector('.comments-section');
        if (existing) existing.remove();
        element.appendChild(commentList);
    } catch (error) {
        alert("Could not load comments.");
    }
}

// --- Task 5: Bonus - Promise.all ---
async function fetchMulti() {
    toggleLoader(true);
    try {
        const [quote, user, todo] = await Promise.all([
            fetch('https://api.quotable.io/random').then(r => r.json()),
            fetch('https://jsonplaceholder.typicode.com/users/1').then(r => r.json()),
            fetch('https://jsonplaceholder.typicode.com/todos/1').then(r => r.json())
        ]);
        console.log("All data fetched:", { quote, user, todo });
    } catch (error) {
        console.error("One of the requests failed.");
    } finally {
        toggleLoader(false);
    }
}

// Event Listeners
document.getElementById('new-quote').addEventListener('click', fetchQuote);
document.getElementById('search-btn').addEventListener('click', searchUser);
document.getElementById('load-more').addEventListener('click', loadPosts);

// Initial Load
fetchQuote();
loadPosts();
