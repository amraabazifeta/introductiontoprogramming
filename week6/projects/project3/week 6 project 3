scores = []

# Collect 5 inputs using a loop and a list
for i in range(5):
    score = float(input(f"Enter score {i + 1}: "))
    scores.append(score)

# Calculate the average using built-in functions
# sum(scores) adds all numbers, len(scores) gives the total count (5)
average = sum(scores) / len(scores)

# Determine the grade using if/elif/else chain
if average >= 90:
    grade = "A"
elif average >= 80:
    grade = "B"
elif average >= 70:
    grade = "C"
elif average >= 60:
    grade = "D"
else:
    grade = "F"

# Print the final result
print(f"Average: {average:.1f}")
print(f"Grade: {grade}")
