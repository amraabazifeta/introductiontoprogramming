menu = {
    1: ("Apple",  0.50),
    2: ("Banana", 0.30),
    3: ("Milk",   1.20),
    4: ("Bread",  2.00),
}

cart  = {}   # { item_name: quantity }
total = 0.0

# --- Display Menu ---
print("--- Shop Menu ---")
for key, value in menu.items():
    print(f"{key}. {value[0]:<8} ${value[1]:.2f}")
print("5. Done\n")

# --- Shopping Loop ---
while True:
    try:
        choice = int(input("Choose an item (1-5): "))
        
        if choice == 5:
            break
        
        if choice in menu:
            item_name, price = menu[choice]
            total += price
            
            # Handling duplicate items
            if item_name in cart:
                cart[item_name] += 1
            else:
                cart[item_name] = 1
                
            print(f"Added {item_name}. Total: ${total:.2f}")
        else:
            print("Invalid choice. Please pick a number from the menu.")
            
    except ValueError:
        print("Please enter a valid number.")

# --- Receipt ---
print("\n--- Receipt ---")
for item_name, quantity in cart.items():
    # Find the unit price from the menu to calculate subtotal
    # (Simplified: we can also store price in the cart dictionary)
    for key in menu:
        if menu[key][0] == item_name:
            unit_price = menu[key][1]
            break
    
    print(f"{item_name:<8} x{quantity}   ${(unit_price * quantity):.2f}")

print("-" * 21)
print(f"Total: ${total:.2f}")
print("Thank you!")
